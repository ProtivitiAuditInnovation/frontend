<?xml version="1.0" encoding="utf-8"?>
<!-- Used only when the frontend App Service runs on Windows (iisnode). Ignored on Linux. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="all-to-node" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <iisnode loggingEnabled="false" />
  </system.webServer>
</configuration>
